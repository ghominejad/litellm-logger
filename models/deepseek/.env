# Direct → DeepSeek, bypassing the proxy (these calls are NOT logged).
# This path needs your real key, so the auth token references DEEPSEEK_API_KEY
# (loaded from the root .env). The ${...} reference is expanded when the bundle
# loads — no special-casing in the switcher.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=${DEEPSEEK_API_KEY}
ANTHROPIC_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash[1m]
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-pro[1m]
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
CLAUDE_CODE_EFFORT_LEVEL=max
