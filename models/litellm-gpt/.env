# Proxy → OpenAI (logged). No secrets here — loaded by `usemodel`.
# Auth token is a dummy the proxy ignores; the real key lives in the root .env.
ANTHROPIC_BASE_URL=http://localhost:4000
ANTHROPIC_AUTH_TOKEN=dummy-token
# Heavy lifters (complex tasks & planning)
ANTHROPIC_MODEL=gpt-5.5
ANTHROPIC_DEFAULT_OPUS_MODEL=gpt-5.5
ANTHROPIC_DEFAULT_SONNET_MODEL=gpt-5.5
# Fast subagents (file search, grep, quick summaries)
ANTHROPIC_DEFAULT_HAIKU_MODEL=gpt-5.5-instant
CLAUDE_CODE_SUBAGENT_MODEL=gpt-5.5-instant
