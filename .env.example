# Copy this file to .env and fill in your provider API keys.
# .env is git-ignored — never commit real keys.

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Timezone for log folder names / timestamps (only matters if logging is on).
# Defaults to UTC; set e.g. Asia/Yerevan or America/New_York for local time.
TIMEZONE=UTC
